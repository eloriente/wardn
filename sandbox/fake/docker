#!/bin/sh
# Fake `docker` for the dev sandbox. Only answers `docker ps -a --format '{{json .}}'`,
# printing the lines of /etc/wardn-fake/docker-ps.jsonl. Edit that file to stage a
# scenario (a crashed container, a stopped one...), no rebuild needed.
if [ "$1 $2 $3 $4" = "ps -a --format {{json .}}" ] && [ "$#" -eq 4 ]; then
    cat /etc/wardn-fake/docker-ps.jsonl
    exit 0
fi
echo "fake docker: unsupported command: $*" >&2
exit 1
